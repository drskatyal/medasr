{
  "name": "flowrad-dictate",
  "productName": "FlowRad Dictate",
  "version": "0.1.0",
  "description": "Local, private medical dictation. On-device Google MedASR; Qwen/Gemma cleanup when the mic stops. Developed by Dr. Sanyam Katyal.",
  "main": "src/main/index.js",
  "author": "Dr. Sanyam Katyal",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "prepare:vosk": "node scripts/fetch-vosk.js",
    "prepare:weights": "node scripts/bundle-weights.js",
    "test": "node --test src/main/runtime.test.js src/main/features.test.js src/main/hotkeys.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "publish": "electron-builder --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "onnxruntime-node": "^1.20.1"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.7.0",
    "sherpa-onnx-node": "^1.10.39",
    "vosk": "^0.3.39",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.flowrad.vr",
    "productName": "FlowRad Dictate",
    "icon": "build/icon.png",
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "files": ["src/**/*", "assets/**/*", "NOTICE.md"],
    "extraResources": [
      { "from": "../models", "to": "models", "filter": ["*.onnx", "*.gguf", "NOTICE.txt", "silero_vad.onnx"] }
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**",
      "**/node_modules/sherpa-onnx-node/**",
      "**/node_modules/sherpa-onnx-*/**",
      "**/node_modules/vosk/**",
      "**/node_modules/uiohook-napi/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"], "category": "Utility" },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.MEDASR_UPDATE_URL}"
      }
    ]
  }
}
